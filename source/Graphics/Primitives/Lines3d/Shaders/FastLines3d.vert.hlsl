    float2 v_pos : TEXCOORD0;
    nointerpolation float4 v_col0 : TEXCOORD1;
    nointerpolation float4 v_col1 : TEXCOORD2;
    nointerpolation float2 v_p0 : TEXCOORD3;
    nointerpolation float2 v_p1 : TEXCOORD4;
    nointerpolation float2 v_prev : TEXCOORD5;
    nointerpolation float v_half : TEXCOORD6;
    nointerpolation float v_aa : TEXCOORD7;
    nointerpolation float v_round : TEXCOORD8;
    nointerpolation float v_ndcz0 : TEXCOORD9;
