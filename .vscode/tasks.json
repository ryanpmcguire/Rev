{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "clever: build CAM",
      "type": "process",
      "command": "python",
      "args": [
        "clever/clever.py",
        "transpile",
        "./CAM/clever.json",
        "--no-embed",
        "-j8"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    }
  ]
}
